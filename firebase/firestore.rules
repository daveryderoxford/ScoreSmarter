rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Auth helpers (mirrors firebase/functions/src/shared/authorisation.ts)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSysAdmin() {
      return isAuthenticated() && (
        request.auth.token.sysAdmin == true ||
        request.auth.uid == 'Uw4HKGlcHla1Fm8Zw8B7DBVyl1j1' ||
        request.auth.uid == 'ybV4KPBh7xY067dNQBSYfrzwtVI2'
      );
    }

    function getClubRole(clubId) {
      return request.auth.token.clubs[clubId];
    }

    function isClubAdmin(clubId) {
      return isSysAdmin() || (isAuthenticated() && getClubRole(clubId) == 'club-admin');
    }

    function isValidScanAiConfig() {
      let data = request.resource.data;
      return data.keys().hasOnly(['model', 'thinkingLevel', 'updatedAt', 'updatedBy'])
        && data.model is string
        && data.model.size() > 0
        && data.model.size() < 128
        && data.thinkingLevel in ['minimal', 'low', 'medium', 'high']
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid;
    }

    function isRO(clubId) {
      return isClubAdmin(clubId) || (isAuthenticated() && getClubRole(clubId) == 'race-officer');
    }

    function isKiosk() {
      return request.auth.token.get('kiosk', false) == true;
    }

    function isValidNewClubClass(c) {
      return c.keys().hasAll(['id', 'name', 'kind', 'handicaps'])
        && c.keys().hasOnly(['id', 'name', 'kind', 'handicaps', 'isSinglehander', 'catalogueId', 'pyOverridden'])
        && c.id is string && c.id.size() > 0
        && c.name is string && c.name.size() > 0
        && c.kind in ['rya', 'local']
        && c.handicaps is list;
    }

    // Appends one class to the end of the club's class list and changes nothing else.
    function isClubClassAppend() {
      let before = resource.data.get('classes', []);
      let after = request.resource.data.get('classes', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classes'])
        && after.size() == before.size() + 1
        && after[0:before.size()] == before
        && isValidNewClubClass(after[before.size()]);
    }

    function isAuthorisedUser(clubId) {
      return isRO(clubId) || (isAuthenticated() && getClubRole(clubId) != null);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Validation helpers
    // ===============================================================

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // On create/update: if field is present it must equal the path segment.
    function createPathKey(field, pathValue) {
      return !(field in request.resource.data) || request.resource.data[field] == pathValue;
    }

    // On update: keyed fields cannot change once stored.
    function pathKeyUnchanged(field) {
      return resource == null
        || !(field in request.resource.data)
        || !(field in resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function idFieldMatches(docId) {
      return createPathKey('id', docId) && pathKeyUnchanged('id');
    }

    function isValidBoat(boatId) {
      return hasRequiredFields(['name', 'ownerUid'])
        && idFieldMatches(boatId);
    }

    function isValidRaceResult() {
      return hasRequiredFields(['raceId', 'seriesEntryId', 'seriesId'])
        && pathKeyUnchanged('raceId')
        && pathKeyUnchanged('seriesId')
        && pathKeyUnchanged('seriesEntryId')
        && enteredByUidOk();
    }

    // On create, enteredByUid (if set) must be the caller. Once stored it cannot change.
    function enteredByUidOk() {
      return !('enteredByUid' in request.resource.data)
        || (resource == null && request.resource.data.enteredByUid == request.auth.uid)
        || (resource != null
          && (!('enteredByUid' in resource.data)
            || request.resource.data.enteredByUid == resource.data.enteredByUid));
    }

    function isValidSeriesEntry() {
      return hasRequiredFields(['seriesId'])
        && pathKeyUnchanged('seriesId');
    }

    function isValidRace(raceId) {
      return hasRequiredFields(['seriesId'])
        && idFieldMatches(raceId)
        && createPathKey('raceId', raceId)
        && pathKeyUnchanged('raceId');
    }

    function isValidSeries(seriesId) {
      return hasRequiredFields(['name'])
        && idFieldMatches(seriesId)
        && createPathKey('seriesId', seriesId)
        && pathKeyUnchanged('seriesId');
    }

    function clubUserRequiredFields() {
      return hasRequiredFields(['role', 'tenantId', 'firstname', 'surname']);
    }

    function clubUserPathKeys(userId, clubId) {
      return createPathKey('id', userId)
        && createPathKey('tenantId', clubId)
        && pathKeyUnchanged('id')
        && pathKeyUnchanged('tenantId');
    }

    function clubUserRoleUnchanged() {
      return resource == null
        || request.resource.data.role == resource.data.role;
    }

    function clubUserCreateValid(userId, clubId) {
      return clubUserRequiredFields()
        && clubUserPathKeys(userId, clubId);
    }

    function clubUserOwnerUpdateValid(userId, clubId) {
      return clubUserRequiredFields()
        && clubUserPathKeys(userId, clubId)
        && clubUserRoleUnchanged();
    }

    function isStringOfSize(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Registration form on the home site; unauthenticated, so validated tightly. The club
    // id pattern and lengths match firebase/functions/src/shared/club-id.ts.
    function isValidClubRegistration(registrationId) {
      let data = request.resource.data;
      let fields = ['id', 'clubName', 'subdomain', 'contactName', 'contactEmail',
        'status', 'source', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.id == registrationId
        && isStringOfSize(data.clubName, 3, 100)
        && isStringOfSize(data.subdomain, 3, 12)
        && data.subdomain.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && isStringOfSize(data.contactName, 2, 100)
        && isStringOfSize(data.contactEmail, 3, 254)
        && data.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.status == 'new'
        && data.source == 'home-site'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Sys-admins reject or reopen requests and keep notes; approval is done by the
    // approveClubRegistration function.
    function isRegistrationReviewUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && resource.data.status in ['new', 'rejected']
        && data.status in ['new', 'rejected']
        && (!('notes' in data) || isStringOfSize(data.notes, 0, 2000))
        && data.updatedAt == request.time;
    }

    function isDutyAttendanceStatus(status) {
      return status in ['not-attending', 'attending', 'confirmed'];
    }

    // Only dutyTeam[i].status may change; identity fields stay put.
    function dutyTeamMemberStatusOnlyUpdate(before, after, i) {
      return i >= before.size() || (
        after[i].keys().hasOnly(['key', 'name', 'role', 'status'])
        && before[i].key == after[i].key
        && before[i].name == after[i].name
        && before[i].role == after[i].role
        && isDutyAttendanceStatus(after[i].status)
      );
    }

    // Rules cannot loop or recurse, so each position is checked explicitly;
    // teams of more than 30 are rejected.
    function dutyTeamStatusOnlyUpdate(b, a) {
      return b.size() <= 30
        && dutyTeamMemberStatusOnlyUpdate(b, a, 0) && dutyTeamMemberStatusOnlyUpdate(b, a, 1)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 2) && dutyTeamMemberStatusOnlyUpdate(b, a, 3)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 4) && dutyTeamMemberStatusOnlyUpdate(b, a, 5)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 6) && dutyTeamMemberStatusOnlyUpdate(b, a, 7)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 8) && dutyTeamMemberStatusOnlyUpdate(b, a, 9)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 10) && dutyTeamMemberStatusOnlyUpdate(b, a, 11)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 12) && dutyTeamMemberStatusOnlyUpdate(b, a, 13)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 14) && dutyTeamMemberStatusOnlyUpdate(b, a, 15)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 16) && dutyTeamMemberStatusOnlyUpdate(b, a, 17)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 18) && dutyTeamMemberStatusOnlyUpdate(b, a, 19)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 20) && dutyTeamMemberStatusOnlyUpdate(b, a, 21)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 22) && dutyTeamMemberStatusOnlyUpdate(b, a, 23)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 24) && dutyTeamMemberStatusOnlyUpdate(b, a, 25)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 26) && dutyTeamMemberStatusOnlyUpdate(b, a, 27)
        && dutyTeamMemberStatusOnlyUpdate(b, a, 28) && dutyTeamMemberStatusOnlyUpdate(b, a, 29);
    }

    function isRaceDayStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dutyTeam'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.dutyTeam is list
        && resource.data.dutyTeam is list
        && request.resource.data.dutyTeam.size() == resource.data.dutyTeam.size()
        && dutyTeamStatusOnlyUpdate(resource.data.dutyTeam, request.resource.data.dutyTeam);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isClubAdmin(clubId);
      // Race officers can add a missing class (e.g. while entering a boat) but not edit classes.
      allow update: if isRO(clubId) && !isKiosk() && isClubClassAppend();

      match /boats/{boatId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidBoat(boatId);
        allow delete: if isRO(clubId);
      }

      match /race-results/{resultId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidRaceResult();
        allow delete: if isRO(clubId)
          || (isAuthenticated() && resource.data.enteredByUid == request.auth.uid);
      }

      match /series-entries/{entryId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidSeriesEntry();
        allow delete: if isRO(clubId);
      }

      match /races/{raceId} {
        allow read: if true;
        allow create, update: if isRO(clubId) && isValidRace(raceId);
        allow delete: if isClubAdmin(clubId);
      }

      match /series/{seriesId} {
        allow read: if true;
        allow create, update: if isRO(clubId) && isValidSeries(seriesId);
        allow delete: if isClubAdmin(clubId);
      }

      match /published_seasons/{seasonId} {
        allow read: if true;
        allow write: if isRO(clubId);
      }

      match /published_series/{seriesId} {
        allow read: if true;
        allow write: if isRO(clubId);

        match /races/{raceId} {
          allow read: if true;
          allow write: if isRO(clubId);
        }
      }

      match /results-sheet-capture-sessions/{sessionId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /scan-results/{raceId} {
        allow read: if isRO(clubId);
        allow create, update: if isRO(clubId);
        allow delete: if isRO(clubId);
      }

      match /users/{userId} {
        allow read: if isOwner(userId) || isClubAdmin(clubId) || isSysAdmin();
        allow create: if isOwner(userId) && clubUserCreateValid(userId, clubId)
          && request.resource.data.role == 'user';
        allow update: if isSysAdmin() && clubUserCreateValid(userId, clubId)
          || isOwner(userId) && clubUserOwnerUpdateValid(userId, clubId);
        allow delete: if isSysAdmin();
      }

      // Kiosk whitelist: club-admin can list; mutations only via Admin SDK callables.
      match /authorized_kiosks/{deviceId} {
        allow read: if isClubAdmin(clubId);
        allow write: if false;
      }

      // Duty roster: created via Admin SDK (syncIbrscDutyTeamDaily); clients may
      // only change dutyTeam[].status when signed in.
      match /race-days/{date} {
        allow read: if true;
        allow create, delete: if false;
        allow update: if isAuthenticated() && isRaceDayStatusOnlyUpdate();
      }
    }

    match /club-registrations/{registrationId} {
      allow create: if isValidClubRegistration(registrationId);
      allow read, delete: if isSysAdmin();
      allow update: if isSysAdmin() && isRegistrationReviewUpdate();
    }

    match /system/public/{id} {
      allow read: if true;
      allow write: if isSysAdmin();
    }

    // Global reference data, e.g. the class catalogue (classCatalogue).
    match /system/public/reference/{docId} {
      allow read: if true;
      allow write: if isSysAdmin();
    }

    match /system/private/{id} {
      allow read, write: if isSysAdmin();
    }

    match /system/private/scans/{scanId} {
      allow read: if isSysAdmin();
      allow write: if false;
    }

    // System scan AI defaults (model + thinking level). Read on every scan by
    // the Admin SDK; clients (sys-admin UI) read/write this document.
    match /system/private/settings/{docId} {
      allow read: if isSysAdmin();
      allow create, update: if isSysAdmin() && docId == 'scanAi' && isValidScanAiConfig();
      allow delete: if false;
    }
  }
}
