rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Auth helpers (mirrors firebase/functions/src/shared/authorisation.ts)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSysAdmin() {
      return isAuthenticated() && (
        request.auth.token.sysAdmin == true ||
        request.auth.uid == 'Uw4HKGlcHla1Fm8Zw8B7DBVyl1j1' ||
        request.auth.uid == 'ybV4KPBh7xY067dNQBSYfrzwtVI2'
      );
    }

    function getClubRole(clubId) {
      return request.auth.token.clubs[clubId];
    }

    function isClubAdmin(clubId) {
      return isSysAdmin() || (isAuthenticated() && getClubRole(clubId) == 'club-admin');
    }

    function isRO(clubId) {
      return isClubAdmin(clubId) || (isAuthenticated() && getClubRole(clubId) == 'race-officer');
    }

    function isAuthorisedUser(clubId) {
      return isRO(clubId) || (isAuthenticated() && getClubRole(clubId) != null);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Validation helpers
    // ===============================================================

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // On create/update: if field is present it must equal the path segment.
    function createPathKey(field, pathValue) {
      return !(field in request.resource.data) || request.resource.data[field] == pathValue;
    }

    // On update: keyed fields cannot change once stored.
    function pathKeyUnchanged(field) {
      return resource == null
        || !(field in request.resource.data)
        || !(field in resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function idFieldMatches(docId) {
      return createPathKey('id', docId) && pathKeyUnchanged('id');
    }

    function isValidBoat(boatId) {
      return hasRequiredFields(['name', 'ownerUid'])
        && idFieldMatches(boatId);
    }

    function isValidRaceResult() {
      return hasRequiredFields(['raceId', 'seriesEntryId', 'seriesId'])
        && pathKeyUnchanged('raceId')
        && pathKeyUnchanged('seriesId')
        && pathKeyUnchanged('seriesEntryId');
    }

    function isValidSeriesEntry() {
      return hasRequiredFields(['seriesId'])
        && pathKeyUnchanged('seriesId');
    }

    function isValidRace(raceId) {
      return hasRequiredFields(['seriesId'])
        && idFieldMatches(raceId)
        && createPathKey('raceId', raceId)
        && pathKeyUnchanged('raceId');
    }

    function isValidSeries(seriesId) {
      return hasRequiredFields(['name'])
        && idFieldMatches(seriesId)
        && createPathKey('seriesId', seriesId)
        && pathKeyUnchanged('seriesId');
    }

    function clubUserRequiredFields() {
      return hasRequiredFields(['role', 'tenantId', 'firstname', 'surname']);
    }

    function clubUserPathKeys(userId, clubId) {
      return createPathKey('id', userId)
        && createPathKey('tenantId', clubId)
        && pathKeyUnchanged('id')
        && pathKeyUnchanged('tenantId');
    }

    function clubUserRoleUnchanged() {
      return resource == null
        || request.resource.data.role == resource.data.role;
    }

    function clubUserCreateValid(userId, clubId) {
      return clubUserRequiredFields()
        && clubUserPathKeys(userId, clubId);
    }

    function clubUserOwnerUpdateValid(userId, clubId) {
      return clubUserRequiredFields()
        && clubUserPathKeys(userId, clubId)
        && clubUserRoleUnchanged();
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isClubAdmin(clubId);

      match /boats/{boatId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidBoat(boatId);
        allow delete: if isRO(clubId);
      }

      match /race-results/{resultId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidRaceResult();
        allow delete: if isRO(clubId);
      }

      match /series-entries/{entryId} {
        allow read: if true;
        allow create, update: if isAuthorisedUser(clubId) && isValidSeriesEntry();
        allow delete: if isRO(clubId);
      }

      match /races/{raceId} {
        allow read: if true;
        allow create, update: if isRO(clubId) && isValidRace(raceId);
        allow delete: if isClubAdmin(clubId);
      }

      match /series/{seriesId} {
        allow read: if true;
        allow create, update: if isRO(clubId) && isValidSeries(seriesId);
        allow delete: if isClubAdmin(clubId);
      }

      match /published_seasons/{seasonId} {
        allow read: if true;
        allow write: if isRO(clubId);
      }

      match /published_series/{seriesId} {
        allow read: if true;
        allow write: if isRO(clubId);

        match /races/{raceId} {
          allow read: if true;
          allow write: if isRO(clubId);
        }
      }

      match /results-sheet-capture-sessions/{sessionId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /scan-results/{raceId} {
        allow read: if isRO(clubId);
        allow create, update: if isRO(clubId);
        allow delete: if isRO(clubId);
      }

      match /users/{userId} {
        allow read: if isOwner(userId) || isClubAdmin(clubId) || isSysAdmin();
        allow create: if isOwner(userId) && clubUserCreateValid(userId, clubId);
        allow update: if isSysAdmin() && clubUserCreateValid(userId, clubId)
          || isOwner(userId) && clubUserOwnerUpdateValid(userId, clubId);
        allow delete: if isSysAdmin();
      }
    }

    match /system/public/{id} {
      allow read: if true;
      allow write: if isSysAdmin();
    }

    match /system/private/{id} {
      allow read, write: if isSysAdmin();
    }

    match /system/private/scans/{scanId} {
      allow read: if isSysAdmin();
      allow write: if false;
    }
  }
}
