{
  "entities": {
    "Club": {
      "title": "Club",
      "description": "Core club configuration and metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the club." },
        "fleets": { "type": "array", "items": { "type": "string" }, "description": "List of fleets in the club." },
        "classes": { "type": "array", "items": { "type": "string" }, "description": "List of boat classes supported." },
        "seasons": { "type": "array", "items": { "type": "string" }, "description": "List of season IDs." },
        "tagDefinitions": {
          "type": "array",
          "items": { "$ref": "#/entities/ClubTagDefinition" },
          "description": "User-managed display metadata for tag ids used on boats and series entries. Default []."
        }
      },
      "required": ["name"]
    },
    "ClubTagDefinition": {
      "title": "Club Tag Definition",
      "description": "Display metadata for a tag id (label and colour). The id is a stable storage key.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Stable storage key, e.g. 'gold'." },
        "label": { "type": "string", "description": "Display label; blank hides the definition from pickers." },
        "color": {
          "type": "string",
          "enum": ["gold", "silver", "bronze", "blue", "green", "purple", "orange", "red"],
          "description": "Optional chip background colour from the fixed palette."
        }
      },
      "required": ["id", "label"]
    },
    "Boat": {
      "title": "Boat",
      "description": "A boat registered in a club.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "class": { "type": "string" },
        "handicap": { "type": "number" },
        "handicaps": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Optional handicap list."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tag ids propagated onto series entries at sign-on. Default []."
        }
      },
      "required": ["name", "ownerUid"]
    },
    "Race": {
      "title": "Race",
      "description": "A single scheduled race.",
      "type": "object",
      "properties": {
        "seriesId": { "type": "string" },
        "seriesName": { "type": "string" },
        "scheduledStart": { "type": "string", "format": "date-time" },
        "index": { "type": "integer" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["seriesId"]
    },
    "Series": {
      "title": "Series",
      "description": "A series of races.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "seasonId": { "type": "string" }
      },
      "required": ["name"]
    },
    "Season": {
      "title": "Season",
      "description": "A sailing season.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "year": { "type": "integer" }
      },
      "required": ["name", "year"]
    },
    "RaceResult": {
      "title": "Race Competitor Result",
      "description": "Per-race competitor row (race-results collection).",
      "type": "object",
      "properties": {
        "raceId": { "type": "string" },
        "seriesId": { "type": "string" },
        "seriesEntryId": { "type": "string" },
        "resultCode": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tag ids copied from the contributing series entry. Default []."
        }
      },
      "required": ["raceId", "seriesId", "seriesEntryId"]
    },
    "PublishedRace": {
      "title": "Published Race",
      "description": "Immutable per-race published results document.",
      "type": "object",
      "properties": {
        "tagDefinitions": {
          "type": "array",
          "items": { "$ref": "#/entities/ClubTagDefinition" },
          "description": "Snapshot of club tag definitions referenced by any results row at publish time. Default []."
        }
      }
    },
    "PublishedSeries": {
      "title": "Published Series",
      "description": "Immutable series-aggregated published results document.",
      "type": "object",
      "properties": {
        "tagDefinitions": {
          "type": "array",
          "items": { "$ref": "#/entities/ClubTagDefinition" },
          "description": "Snapshot of club tag definitions referenced by any competitor row at publish time. Default []."
        }
      }
    },
    "SeriesEntry": {
      "title": "Series Entry",
      "description": "A hull entry into a series.",
      "type": "object",
      "properties": {
        "seriesId": { "type": "string" },
        "helm": { "type": "string" },
        "boatClass": { "type": "string" },
        "sailNumber": { "type": "object" },
        "handicaps": { "type": "array", "items": { "type": "object" } },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tag ids carried on this entry. Default []."
        }
      },
      "required": ["seriesId"]
    },
    "ClubUser": {
      "title": "Club User",
      "description": "Club-scoped user profile and role.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["sys-admin", "club-admin", "race-officer", "user"] },
        "tenantId": { "type": "string" },
        "firstname": { "type": "string" },
        "surname": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "boats": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["role", "tenantId", "firstname", "surname"]
    },
    "SystemData": {
      "title": "System Data",
      "description": "Global system configuration.",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/clubs/{clubId}": {
      "schema": "Club",
      "description": "Club settings."
    },
    "/clubs/{clubId}/boats/{boatId}": {
      "schema": "Boat",
      "description": "Boats in the club."
    },
    "/clubs/{clubId}/race-results/{resultId}": {
      "schema": "RaceResult",
      "description": "Race competitor rows."
    },
    "/clubs/{clubId}/series-entries/{entryId}": {
      "schema": "SeriesEntry",
      "description": "Series entries."
    },
    "/clubs/{clubId}/races/{raceId}": {
      "schema": "Race",
      "description": "Scheduled races for the club."
    },
    "/clubs/{clubId}/results-sheet-capture-sessions/{sessionId}": {
      "schema": "ResultsSheetCaptureSession",
      "description": "Ephemeral phone-capture QR sessions (read by desktop; writes via Cloud Functions only)."
    },
    "/clubs/{clubId}/scan-results/{raceId}": {
      "schema": "ScanResults",
      "description": "Persisted results-sheet parse for a race until reviewed or cleared."
    },
    "/clubs/{clubId}/series/{seriesId}": {
      "schema": "Series",
      "description": "Series definitions."
    },
    "/clubs/{clubId}/users/{userId}": {
      "schema": "ClubUser",
      "description": "Club-scoped user profiles and roles."
    },
    "/clubs/{clubId}/published_seasons/{seasonId}": {
      "schema": "Season",
      "description": "Published season index documents."
    },
    "/clubs/{clubId}/published_series/{seriesId}": {
      "schema": "PublishedSeries",
      "description": "Published series aggregate documents."
    },
    "/clubs/{clubId}/published_series/{seriesId}/races/{raceId}": {
      "schema": "PublishedRace",
      "description": "Published per-race result documents."
    },
    "/system/public/{id}": {
      "schema": "SystemData",
      "description": "Public system data."
    },
    "/system/private/{id}": {
      "schema": "SystemData",
      "description": "Private system data."
    },
    "/system/private/scans/{scanId}": {
      "schema": "SystemData",
      "description": "Scan metrics (written by Cloud Functions; sys-admin read)."
    }
  }
}
