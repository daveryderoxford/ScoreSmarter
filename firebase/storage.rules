rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for scanner/race sheet assets.
    match /clubs/{clubId}/results-sheets/{fileName} {
      allow read: if true;
      // Uploads are mediated by Cloud Functions/Admin SDK.
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null &&
        !allPaths.matches('clubs/[^/]+/results-sheets/.*');
    }
  }
}
