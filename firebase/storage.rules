rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for scanner/race sheet assets (uploads via Cloud Functions only).
    match /clubs/{clubId}/results-sheets/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /clubs/{clubId}/club-logo.jpg {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
