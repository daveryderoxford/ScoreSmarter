{
  "name": "scoresmarter-web",
  "version": "0.1.0",
  "scripts": {
    "dev": "ng serve --port 3000",
    "serve": "ng serve",
    "build": "ng build",
    "start": "node serve.cjs",
    "stats": "ng build --stats-json --named-chunks && npx @angular-experts/hawkeye dist/sailbrowser/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:barrels": "eslint \"src/app/**/index.ts\"",
    "storybook": "ng run sailbrowser-web:storybook",
    "build-storybook": "ng run sailbrowser-web:build-storybook"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/fire": "^20.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.0.0",
    "@angular/material-date-fns-adapter": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/pwa": "22.0.0",
    "@angular/router": "22.0.0",
    "@angular/service-worker": "22.0.0",
    "@ngbracket/ngx-layout": "15.1.3",
    "angularx-qrcode": "^21.0.5",
    "date-fns": "^4.1.0",
    "rxjs": "~7.8.0",
    "superstatic": "^10.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "22.0.0",
    "@angular-devkit/core": "22.0.0",
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-styling-webpack": "^3.0.0",
    "@storybook/angular": "^10.2.10",
    "angular-eslint": "22.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-storybook": "^10.2.10",
    "firebase-tools": "^14.0.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "storybook": "^10.2.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/router": "$@angular/router",
      "@angular/platform-server": "22.0.0",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    }
  }
}