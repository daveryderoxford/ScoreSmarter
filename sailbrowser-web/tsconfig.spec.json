/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
  "baseUrl": "./",
    "paths": {
      "app/*": ["src/app/*"],
      "@env/*": ["src/environments/*"],
      "@testing/*": ["src/testing/*"],
      "@shared/scanner-context": ["../shared/contracts/scanner-context.d.ts"],
      "@shared/scan-metrics": ["../shared/contracts/scan-metrics.d.ts"],
      "@shared/duty-member": ["../shared/contracts/duty-member.d.ts"],
      "@shared/race-day": ["../shared/contracts/race-day.d.ts"]
    },
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts"
  ]
}
